{
  "name": "budget",
  "version": "1.0.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:up": "npx mikro-orm migration:up",
    "db:create": "npx mikro-orm migration:create",
    "db:down": "npx mikro-orm migration:down",
    "db:list": "npx mikro-orm migration:list",
    "db:seed": "npx mikro-orm seeder:run",
    "db:refresh": "npx mikro-orm schema:fresh --run --seed",
    "db:force": "npx mikro-orm schema:fresh --run"
  },
